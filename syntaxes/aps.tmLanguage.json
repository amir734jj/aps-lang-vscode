{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "aps",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#bindings"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"name": "comment.line.double-dash.aps",
			"begin": "--",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.comment.aps" }
			},
			"end": "$"
		},
		"declarations": {
			"patterns": [
				{
					"name": "meta.declaration.module.aps",
					"match": "\\b(module)\\s+([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.namespace.aps" }
					}
				},
				{
					"name": "meta.declaration.class.aps",
					"match": "\\b(class)\\s+([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.type.class.aps" }
					}
				},
				{
					"name": "meta.declaration.signature.aps",
					"match": "\\b(signature)\\s+([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.type.interface.aps" }
					}
				},
				{
					"name": "meta.declaration.type.aps",
					"match": "\\b(type|phylum)\\s+([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.type.aps" }
					}
				},
				{
					"name": "meta.declaration.callable.aps",
					"match": "\\b(constructor|pattern|function|procedure)\\s+(\\{\\.\\}|[A-Za-z][A-Za-z0-9_]*|\\([^\\r\\n)]*\\))",
					"captures": {
						"1": { "name": "storage.type.function.aps" },
						"2": { "name": "entity.name.function.aps" }
					}
				},
				{
					"name": "meta.attribute.aps",
					"match": "\\b(attribute)\\s+(?:([A-Za-z][A-Za-z0-9_]*)\\s*\\.\\s*)?([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.type.aps" },
						"3": { "name": "entity.name.variable.field.aps" }
					}
				},
				{
					"name": "meta.pragma.aps",
					"match": "\\b(pragma)\\s+([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.aps" },
						"2": { "name": "entity.name.function.aps" }
					}
				}
			]
		},
		"bindings": {
			"patterns": [
				{
					"name": "meta.binding.pattern.aps",
					"match": "(\\?)\\s*([A-Za-z][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "punctuation.definition.variable.aps" },
						"2": { "name": "variable.parameter.aps" }
					}
				},
				{
					"name": "variable.other.definition.aps",
					"match": "\\b[A-Za-z][A-Za-z0-9_]*\\b(?=\\s*:)(?!\\s*::)"
				},
				{
					"name": "constant.language.aps",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "storage.modifier.aps",
					"match": "\\b(circular|collection|constant|input|private|public|remote|var)\\b"
				},
				{
					"name": "storage.type.aps",
					"match": "\\b(attribute|class|constructor|function|module|pattern|phylum|procedure|signature|type)\\b"
				},
				{
					"name": "keyword.control.aps",
					"match": "\\b(begin|case|elscase|else|elsif|end|endif|for|if|match|then)\\b"
				},
				{
					"name": "keyword.other.aps",
					"match": "\\b(extends|inherit|infix|infixl|infixr|on|pragma|with)\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.aps",
					"begin": "\"",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aps" } },
					"end": "\"",
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.aps" } },
					"patterns": [{ "name": "constant.character.escape.aps", "match": "\\\\(?:.|$)" }]
				},
				{
					"name": "string.quoted.single.aps",
					"begin": "'",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aps" } },
					"end": "'",
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.aps" } },
					"patterns": [{ "name": "constant.character.escape.aps", "match": "\\\\(?:.|$)" }]
				}
			]
		},
		"numbers": {
			"patterns": [
				{ "name": "constant.numeric.float.aps", "match": "\\b[0-9][A-Za-z0-9_]*\\.[0-9][A-Za-z0-9_]*\\b" },
				{ "name": "constant.numeric.integer.aps", "match": "\\b[0-9][A-Za-z0-9_]*\\b" }
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.word.aps", "match": "\\b(and|in|not|or|remote)\\b" },
				{ "name": "keyword.operator.quoted.aps", "match": "`[A-Za-z_][A-Za-z0-9_]*`" },
				{ "name": "keyword.operator.aps", "match": ":::+|\\.\\.\\.|::|:=|:>|:\\?|->|\\.\\.|[~@#$%^&*+=<>/\\\\|:-]+" }
			]
		},
		"punctuation": {
			"patterns": [
				{ "name": "punctuation.section.parens.aps", "match": "[()]" },
				{ "name": "punctuation.section.brackets.aps", "match": "[\\[\\]]" },
				{ "name": "punctuation.section.braces.aps", "match": "[{}]" },
				{ "name": "punctuation.separator.aps", "match": "[;,]" },
				{ "name": "punctuation.accessor.aps", "match": "[.$]" }
			]
		}
	},
	"scopeName": "source.aps"
}